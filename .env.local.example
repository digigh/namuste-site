# ==============================================================================
# NAMUSTE WEBSITE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For production on Vercel: Add these keys under Project Settings -> Environment Variables.
# NOTE: DO NOT commit real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & DATABASE (OPTIONAL)
# ------------------------------------------------------------------------------

# Canonical Site URL (Used for metadata & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://namuste.in

# Supabase Configuration (Optional - only needed if connecting direct database features)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. LIVE CLINIC RECEPTIONIST (LiveKit) — used by /api/livekit-token
# ------------------------------------------------------------------------------
# From cloud.livekit.io -> your project -> Settings -> API keys. The same project the
# clinic-agent is deployed to. The secret stays on the server; never prefix these
# with NEXT_PUBLIC_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: agent name (default clinic-agent) and extra allowed origins (comma-separated)
LIVEKIT_AGENT_NAME=
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 3. SUPABASE KEEP-ALIVE — used by /api/keepalive (daily Vercel Cron)
# ------------------------------------------------------------------------------
# Free Supabase projects pause after 7 idle days; a daily ping prevents that.
# SUPABASE_URL: Supabase -> Project Settings -> API (https://<ref>.supabase.co)
# SUPABASE_PUBLISHABLE_KEY: the sb_publishable_... key (safe to use from servers/browsers)
# CRON_SECRET: any long random string; Vercel sends it with each cron call.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CRON_SECRET=
