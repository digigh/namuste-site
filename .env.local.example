# ==============================================================================
# NAMUSTE WEBSITE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For production on Vercel: Add these keys under Project Settings -> Environment Variables.
# NOTE: DO NOT commit real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI ENGINES (REQUIRED FOR LIVE AI DEMO & VOICE CONVERSATIONS)
# ------------------------------------------------------------------------------

# OpenAI API Key (Required)
# Used for conversational intelligence, intent understanding, and structured CRM extraction (gpt-4o-mini).
# Also serves as fallback for Whisper speech-to-text if Sarvam is unavailable.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Sarvam AI API Subscription Key (Required)
# Used for low-latency Indian speech-to-text (saaras:v3) and natural voice synthesis (bulbul:v3).
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ------------------------------------------------------------------------------
# 2. RESILIENCE & BACKUP (OPTIONAL)
# ------------------------------------------------------------------------------

# Google Gemini API Key (Optional Fallback)
# Provides automatic zero-downtime failover if OpenAI encounters rate limits or service hiccups.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. WEBHOOK DISPATCH (OPTIONAL)
# ------------------------------------------------------------------------------

# Appointment / Lead Webhook URL (Optional)
# Dispatches consultation booking details (patient name, phone, doctor/department, slot) 
# to your WhatsApp gateway, CRM, or Make.com / Zapier webhook.
AI_DEMO_WEBHOOK_URL=https://your-webhook-endpoint.com/api/leads

# ------------------------------------------------------------------------------
# 4. SITE & DATABASE (OPTIONAL)
# ------------------------------------------------------------------------------

# Canonical Site URL (Used for metadata & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://namuste.in

# Supabase Configuration (Optional - only needed if connecting direct database features)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
