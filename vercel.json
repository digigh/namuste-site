{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/agri-whatsapp",
      "schedule": "*/30 * * * *"
    }
  ]
}
